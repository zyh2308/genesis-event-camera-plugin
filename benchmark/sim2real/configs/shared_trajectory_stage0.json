{
  "schema_version": 1,
  "purpose": "Stage-0 engineering fixture; not a sensor calibration or benchmark result",
  "simulation": {
    "backend": "genesis.gpu",
    "genesis_version": "1.2.2",
    "physics_dt_s": 0.001,
    "endpoint_rate_hz": 100,
    "duration_s": 0.1,
    "image_size_wh": [160, 128],
    "gravity_m_s2": [0.0, 0.0, -9.81],
    "camera": {
      "position_m": [0.8, 0.8, 0.65],
      "look_at_m": [0.0, 0.0, 0.35],
      "vertical_fov_deg": 50.0,
      "near_m": 0.05,
      "far_m": 10.0
    },
    "target_box": {
      "size_m": [0.16, 0.16, 0.16],
      "initial_z_m": 0.5,
      "initial_x_train_m": -0.08,
      "initial_x_validation_m": 0.08
    },
    "episodes": [
      {"id": "train_00", "split": "train", "initial_x_m": -0.08},
      {"id": "validation_00", "split": "validation", "initial_x_m": 0.08}
    ]
  },
  "shared_labels": {
    "frame_time_reference": "simulator scene.cur_t at each endpoint",
    "event_window": "(t_i,t_i_plus_1]",
    "pose_label_time": "right endpoint",
    "flow": "forward displacement in pixels per endpoint interval from depth, segmentation, camera SE(3), and rigid-link SE(3)",
    "split_unit": "entire physical rollout"
  },
  "eventgenesis": {
    "entrypoint": "genesis_event_plugin.physics_plugin.GenesisPhysicsEventPlugin",
    "input_space": "linear",
    "response_mode": "physical_log",
    "radiometric_calibration_status": "uncalibrated",
    "warp_backend": "numpy",
    "device": "cpu",
    "pos_thres": 0.2,
    "neg_thres": 0.2,
    "sigma_thres": 0.03,
    "cutoff_hz": 300.0,
    "leak_rate_hz": 0.01,
    "leak_jitter_fraction": 0.1,
    "noise_rate_cov_decades": 0.1,
    "shot_noise_rate_hz": 0.001,
    "refractory_period_s": 0.0005,
    "seed": 42
  },
  "v2e": {
    "repository": "https://github.com/SensorsINI/v2e",
    "commit": "cac638444557a224ba6ee5c29260916f152c00bd",
    "input_rate_hz": 100,
    "auto_timestamp_resolution": false,
    "timestamp_resolution_s": 0.001,
    "slomo_checkpoint_name": "SuperSloMo39.ckpt",
    "thresholds_log_e": {"positive": 0.2, "negative": 0.2, "sigma": 0.03},
    "cutoff_hz": 300.0,
    "leak_rate_hz": 0.01,
    "leak_jitter_fraction": 0.1,
    "noise_rate_cov_decades": 0.1,
    "shot_noise_rate_hz": 0.001,
    "refractory_period_s": 0.0005,
    "seed": 42
  },
  "v2e_input_mapping": {
    "input": "scene-linear RGB radiance from the same Genesis endpoint render",
    "luminance": "Rec.709 linear Y",
    "exposure": 1.0,
    "display_transform": "Reinhard(Y) followed by sRGB transfer function",
    "quantization": "uint8 round-to-nearest",
    "per_frame_auto_exposure_or_normalization": false,
    "status": "candidate fixed mapping; synthetic-only pilot check, not sensor calibration"
  },
  "known_pipeline_differences": [
    "EventGenesis uses physics/pose interpolation between the shared endpoint frames; V2E uses pinned SuperSloMo at 1 ms timestamp resolution.",
    "V2E receives one fixed global radiance-to-display mapping; EventGenesis receives native linear radiance.",
    "The pilot records nominal common threshold/noise parameters but does not claim equal noise realizations or target-camera calibration."
  ]
}
